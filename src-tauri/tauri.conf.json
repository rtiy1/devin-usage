{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devin-usage",
  "version": "0.1.0",
  "identifier": "com.rtiy1.devinusage",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Devin 用量",
        "width": 860,
        "height": 720,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
